#!/bin/sh
# Demo stand-in for the claude CLI, used by bin/make-screenshots.mjs and bin/make-demos.mjs (see demo.mjs).
case "$1" in
  auth) echo '{"loggedIn":true,"authMethod":"claude.ai","subscriptionType":"max"}'; exit 0 ;;
  -p) ;;
  --version) echo "2.0.0 (Claude Code)"; exit 0 ;;
  *) exit 1 ;;
esac
if [ "$2" = "/usage" ]; then printf '{"is_error":false,"result":"Current session: 23%% used \302\267 resets Nov 3 at 1:00am (UTC)"}\n'; exit 0; fi
exec node "$(dirname "$0")/demo.mjs" "$@"
