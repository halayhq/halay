# Copy to .env in the data folder (~/.halay/.env by default; a git clone's own .env is read too) and adjust.
# Read at startup. Precedence: real environment variables, then <data folder>/.env, then the clone's .env.

# HTTPS address the app is reached at (e.g. via `tailscale serve`). Used for the Web Push VAPID
# subject and the "open over HTTPS" hint in Settings. The Settings page value overrides it.
# HALAY_PUBLIC_URL=https://your-machine.your-tailnet.ts.net

# HALAY_HOME=~/.halay        # the data folder: token, database, runs/, tmp/, bots/, plugins/, logs (default ~/.halay; a git
#                            # checkout that already holds .token or halay.db keeps using itself). Set it in the environment
#                            # or in a clone's .env, not in the data folder's own .env.
# PORT=4777
# HOST=127.0.0.1             # 0.0.0.0 to reach it from your phone (Tailscale/LAN only)
# HALAY_TOKEN=               # access token; default is generated into <data folder>/.token
# HALAY_LOCAL_APP=0         # turn off the Mac app's local sign-in (the local-app-token file and POST /auth/local)
# HALAY_RESET_PASSKEYS=1     # must be exactly 1; for ONE start: delete all passkeys and browser sessions (then set up again with the token)
# HALAY_DB=                  # database file (default <data folder>/halay.db). Set without
#                            # HALAY_HOME, its folder becomes the data folder (runs/ etc. always lived next to it)
# HALAY_UPLOAD_MAX_MB=50
# HALAY_KILL_AGENTS=1        # stop agents and web terminals when the server stops
# HALAY_TERMINAL=0           # turn off the web terminal (a login shell for anyone with the token)
# HALAY_HTTPS_PORT=4778      # HTTPS, when there is a certificate (`halay cert install`, or the two below); plain http then stays on 127.0.0.1
# HALAY_TLS_CERT=            # your own certificate (PEM) instead of halay's; never renewed or written by halay
# HALAY_TLS_KEY=             # its key (PEM)
# HALAY_HTTP_HOST=           # where plain http listens (default: 127.0.0.1 when HTTPS is on, else HOST)
# HALAY_OPENSSL=openssl      # the openssl binary `halay cert` uses
# HALAY_RESTART=spawn        # Settings → Restart server: spawn = start again via a detached helper, exit = exit 75 for a supervisor (default: detected)
# HALAY_BROWSER_PATH=        # Chromium/Chrome binary for the agents' browser (default: Playwright's cache, then the usual Chrome/Chromium locations)
# PLAYWRIGHT_BROWSERS_PATH=  # where `npx playwright install chromium` put Chromium (default ~/Library/Caches/ms-playwright on macOS, ~/.cache/ms-playwright elsewhere)
# HALAY_PEER_NAME=           # the name this server calls itself towards peers (default: host name)
# HALAY_PLUGINS=0            # safe mode: start with every plugin off
# HALAY_PLUGINS_DIR=         # where local plugins live (default: <data folder>/plugins)
# HALAY_BACKENDS=claude,opencode  # limit the agent CLIs offered (ids: claude, opencode, gemini, cursor, antigravity; default: every installed one)
# HALAY_ACCOUNTS_DIR=        # where accounts added in Settings get their folder (default ~/.halay-accounts)
# HALAY_MAX_LIVE=60          # most agents running at once that agents may start via the swarm MCP
